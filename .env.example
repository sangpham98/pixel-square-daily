# === Telegram Bot ===
# Get from @BotFather
TELEGRAM_BOT_TOKEN=123456:YOUR_BOT_TOKEN
# Your Telegram chat ID
TELEGRAM_CHAT_ID=123456789

# === Telegram Webhook ===
# Public HTTPS base URL for Telegram webhook, e.g. Cloudflare Tunnel/ngrok/domain
WEBHOOK_PUBLIC_URL=https://pixel.yourdomain.com
# Custom secret used to verify Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=change-me
# Seconds to remember processed Telegram update IDs
TELEGRAM_UPDATE_DEDUP_TTL=900

# === LLM Primary Provider ===
# Any OpenAI-compatible Chat Completions endpoint works: OpenRouter, OpenAI, Ollama, LM Studio, vLLM, etc.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your_key_here
OPENAI_MODEL=openai/gpt-4o-mini

# === LLM Optional Fallback Providers ===
# JSON array format, example:
# OPENAI_FALLBACK_PROVIDERS=[{"base_url":"https://api.openai.com/v1","api_key":"sk-your_key","model":"gpt-4o-mini"}]
OPENAI_FALLBACK_PROVIDERS=
FALLBACK_OPENAI_BASE_URL=
FALLBACK_OPENAI_API_KEY=
FALLBACK_OPENAI_MODEL=

# === Binance Square ===
BINANCE_SQUARE_OPENAPI_KEY=your_square_openapi_key
BINANCE_AUTO_POST_SHORT=true

# === Generation / Runtime ===
RUN_ONCE=false
# Used only by pixel_square_daily.py scheduler mode
SCHEDULE_TIME=09:00
LOG_LEVEL=INFO
SIMILARITY_MAX_REGENERATIONS=3
SIMILARITY_BLOCK_THRESHOLD=0.98
COIN_RECENT_EXCLUDE_HOURS=48
# Optional custom SQLite path; leave blank to use ./history.db
HISTORY_DB=
