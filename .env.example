# Telegram bot
TELEGRAM_BOT_TOKEN=123456:YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# Telegram webhook mode
# For local tests with polling-like RUN_ONCE you can leave webhook empty.
# For production webhook, set a public HTTPS base URL, e.g. Cloudflare Tunnel/ngrok/domain.
WEBHOOK_PUBLIC_URL=https://your-domain.example.com
TELEGRAM_WEBHOOK_SECRET=change-me
WEBHOOK_LOCAL_HOST=127.0.0.1
WEBHOOK_LOCAL_PORT=8096

# LLM endpoint compatible with OpenAI Chat Completions
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=qw/qwen3-coder-plus

# Generation/runtime
RUN_ONCE=false
LOG_LEVEL=INFO
SOURCE_CACHE_TTL_SECONDS=900
SIMILARITY_MAX_REGENERATIONS=1
SIMILARITY_BLOCK_THRESHOLD=0.30
COIN_RECENT_EXCLUDE_COUNT=10
COIN_RECENT_EXCLUDE_HOURS=48

# Auto post the short post to Binance Square after generation
BINANCE_AUTO_POST_SHORT=true
BINANCE_SQUARE_OPENAPI_KEY=your_square_openapi_key
