[Unit]
Description=Hot Coin Binance Square Auto Poster (one-shot)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace/pixel-square-daily
ExecStart=%h/.openclaw/workspace/pixel-square-daily/.venv/bin/python %h/.openclaw/workspace/pixel-square-daily/pixel_square_daily.py
Environment=PYTHONUNBUFFERED=1
Environment=RUN_ONCE=true
